{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug (GDB - MSYS2)",
            "type": "cppdbg",
            "request": "launch",

            "program": "${command:cmake.launchTargetPath}",
            "cwd": "${workspaceFolder}",
            "args": [],

            "MIMode": "gdb",
            "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe",

            "stopAtEntry": false,
            "externalConsole": false,

            "setupCommands": [
                {
                    "description": "Enable pretty printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}